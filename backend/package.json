{
  "name": "dhanova-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "tsx src/scripts/seed-products.ts",
    "import:haldirams": "tsx src/scripts/import-haldirams-catalogue.ts",
    "import:beauty-cadbury": "tsx src/scripts/import-beauty-cadbury-catalogues.ts",
    "import:biscuits-icecream-drinks": "tsx src/scripts/import-biscuits-icecream-drinks-catalogue.ts",
    "import:staples-home-decor": "tsx src/scripts/import-staples-home-decor-catalogue.ts",
    "import:baby-products": "tsx src/scripts/import-baby-products-catalogue.ts",
    "sync-images:cadbury-cococart": "tsx src/scripts/sync-cadbury-cococart-images.ts",
    "sync-images:bigbasket": "tsx src/scripts/sync-bigbasket-product-images.ts",
    "sync-images:amul": "tsx src/scripts/sync-amul-official-images.ts",
    "sync-images:related": "tsx src/scripts/sync-related-fallback-images.ts",
