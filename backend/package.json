    "jose": "^6.2.8",
    "mongoose": "^9.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "fast-xml-parser": "^5.10.1",
    "fflate": "^0.8.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
